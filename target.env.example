# ==============================================================================
# Talos Kubernetes Platform - Deployment Target Configuration Template
# ==============================================================================
# Copy to 'target.env' or generate automatically using 'make configure'.
# This file defines the single source of truth for the target hypervisor server.
# ==============================================================================

# Target Hypervisor Connection
TARGET_HOST="192.168.9.110"
TARGET_USER="bjarrett"
TARGET_SSH_KEY="/home/bjarrett/.ssh/id_ed25519"
TARGET_SSH_PUBKEY="/home/bjarrett/.ssh/id_ed25519.pub"

# Libvirt Hypervisor Settings
TARGET_LIBVIRT_URI="qemu+ssh://bjarrett@192.168.9.110/system?keyfile=/home/bjarrett/.ssh/id_ed25519"
TARGET_STORAGE_POOL="default"
TARGET_NETWORK="default"
TARGET_MAC="52:54:00:BA:67:8E"

# Sandbox VM Resource Sizing
SANDBOX_VCPU="8"
SANDBOX_MEMORY_MB="12288"
SANDBOX_DISK_BYTES="64424509440"

